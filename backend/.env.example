# ==============================================================================
# OIL-SIF-AI-NEW Backend Environment Configuration
# ==============================================================================

# Database Configuration (Defaults to SQLite fallback if left empty or set to sqlite:///...)
# For SQLite on Windows:
DATABASE_URL=sqlite:///./data/oil_sif_safety.db

# For PostgreSQL (Docker or local):
# DATABASE_URL=postgresql://oil_admin:oil_secure_password_sih2024@localhost:5432/oil_sif_db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Directory where trained ML models (.joblib) and metrics are stored
MODEL_DIR=./models

# Expected path to synthetic CSV dataset
DATASET_PATH=../data/OIL_SIF_Synthetic_Dataset_5000.csv

# Server Port and Host
HOST=0.0.0.0
PORT=8000
