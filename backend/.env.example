# OIL-SIF-AI Database Configuration
# Primary MySQL Connection (PyMySQL):
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/oil_sif_ai

# Fallback SQLite Connection (Automatic fallback if MySQL is unreachable):
# DATABASE_URL=sqlite:///data/oil_sif_safety.db

# Server Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Optional Vision AI Cloud API Key (Gemini Flash Vision / Cloud Vision)
# If left unset, the backend automatically uses its built-in local Computer Vision Feature Analyzer
# GEMINI_API_KEY=your_gemini_api_key_here
# VISION_API_KEY=your_vision_api_key_here

